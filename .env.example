# Absolute API origin (media URLs + production builds).
# Vite DEV JSON calls use same-origin `/api` by default and proxy here.
VITE_API_BASE_URL=https://api.feezo.app

# DEV only: set to 0/false/off to call VITE_API_BASE_URL cross-origin (bypass Vite proxy).
# VITE_API_USE_PROXY=0

# Google Sign-In (OAuth Web client ID from Google Cloud Console).
# Required at build time for the Continue with Google button on /login.
VITE_GOOGLE_CLIENT_ID=

# Enable the PWA service worker during `vite dev` (off by default):
# VITE_PWA_DEV=1
